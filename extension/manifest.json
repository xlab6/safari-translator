{
  "manifest_version": 2,
  "name": "Safari Translator — 网页翻译",
  "version": "1.2.0",
  "description": "选中文字即可翻译，按需翻译整页；翻译过的站点会记住并在再次访问时自动续译。可配置微软 Azure、阿里云、腾讯云、DeepL、Google 等服务。Translate selected text, translate a page on demand, and resume sites you already translated; supports Azure, Alibaba Cloud, Tencent Cloud, DeepL, Google and more.",
  "permissions": [
    "storage",
    "contextMenus",
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "providers.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "网页翻译",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
