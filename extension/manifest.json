{
  "manifest_version": 2,
  "name": "Safari Translator — 网页翻译",
  "version": "1.0.2",
  "description": "划词翻译与整页翻译，默认替换原文，支持微软 Azure、阿里云、腾讯云、DeepL、Google 等翻译服务。Select text or translate a whole page with the provider you trust.",
  "permissions": [
    "storage",
    "contextMenus",
    "*://*/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "providers.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "网页翻译",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png",
      "256": "icons/icon-256.png",
      "512": "icons/icon-512.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
